---
// Calendar.astro — Calendario de disponibilidad
---

<section id="calendario" class="py-24 bg-[#0A0A0A]">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Header -->
    <div class="mb-16">
      <p class="font-['Space_Mono'] text-xs text-[#BFFF00] tracking-widest uppercase mb-3">— Disponibilidad</p>
      <h2 class="font-['Bebas_Neue'] text-6xl md:text-7xl text-white leading-none">
        AGENDA<br /><span class="text-[#BFFF00]">DISPONIBLE</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8">

      <!-- Calendario -->
      <div class="bg-[#111] border border-white/10 p-6">

        <!-- Navegación mes -->
        <div class="flex items-center justify-between mb-6">
          <button id="prev-month" class="w-8 h-8 flex items-center justify-center text-gray-500 hover:text-[#BFFF00] transition-colors">←</button>
          <p id="month-title" class="font-['Bebas_Neue'] text-2xl text-white tracking-widest"></p>
          <button id="next-month" class="w-8 h-8 flex items-center justify-center text-gray-500 hover:text-[#BFFF00] transition-colors">→</button>
        </div>

        <!-- Días de la semana -->
        <div class="grid grid-cols-7 mb-2">
          {['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'].map(day => (
            <div class="text-center font-['Space_Mono'] text-xs text-gray-600 uppercase py-2">{day}</div>
          ))}
        </div>

        <!-- Grid de días -->
        <div id="calendar-grid" class="grid grid-cols-7 gap-1"></div>

        <!-- Leyenda -->
        <div class="flex gap-6 mt-6 pt-4 border-t border-white/10">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-[#BFFF00]"></div>
            <span class="font-['Space_Mono'] text-xs text-gray-500">Disponible</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-red-500/50"></div>
            <span class="font-['Space_Mono'] text-xs text-gray-500">Ocupado</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-white/10"></div>
            <span class="font-['Space_Mono'] text-xs text-gray-500">No disponible</span>
          </div>
        </div>
      </div>

      <!-- Horas del día seleccionado -->
      <div class="bg-[#111] border border-white/10 p-6">
        <p id="selected-date-title" class="font-['Bebas_Neue'] text-2xl text-white tracking-widest mb-6">
          SELECCIONA UN DÍA
        </p>

        <div id="hours-grid" class="grid grid-cols-3 gap-2">
          <p class="col-span-3 font-['Space_Mono'] text-xs text-gray-600 text-center py-8">
            Toca un día disponible para ver los horarios
          </p>
        </div>

        <!-- CTA reservar -->
        <div id="reserve-cta" class="hidden mt-6 pt-4 border-t border-white/10">
          <p class="font-['Space_Mono'] text-xs text-gray-500 mb-3">¿Te gusta este horario?</p>
          <a
            href="#reservar"
            class="block text-center bg-[#BFFF00] text-black font-bold py-3 text-sm tracking-widest uppercase hover:bg-[#BFFF00]/80 transition-colors"
          >
            Reservar este horario →
          </a>
        </div>
      </div>

    </div>
  </div>class="relative z-10 w-52 h-52 object-cover rounded-full border-2 border-[#BFFF00]/40"
</section>

<script>
  const HOURS = ['9:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00', '19:00'];
  const MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

  let currentDate = new Date();
  let selectedDay: string | null = null;

  function getAppointments() {
    return JSON.parse(localStorage.getItem('appointments') ?? '[]');
  }

  // Obtener horas ocupadas para un día
  function getBusyHours(dateStr: string): string[] {
    return getAppointments()
      .filter((a: any) => a.date === dateStr && a.status !== 'rejected')
      .map((a: any) => a.time);
  }

  // Obtener días ocupados del mes
  function getBusyDays(year: number, month: number): Set<number> {
    const busy = new Set<number>();
    getAppointments()
      .filter((a: any) => a.status !== 'rejected')
      .forEach((a: any) => {
        const d = new Date(a.date);
        if (d.getFullYear() === year && d.getMonth() === month) {
          busy.add(d.getDate());
        }
      });
    return busy;
  }

  function renderCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    const today = new Date();

    document.getElementById('month-title')!.textContent =
      `${MONTHS[month]} ${year}`;

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const busyDays = getBusyDays(year, month);

    const grid = document.getElementById('calendar-grid')!;
    grid.innerHTML = '';

    // Espacios vacíos al inicio
    for (let i = 0; i < firstDay; i++) {
      grid.innerHTML += `<div></div>`;
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const date = new Date(year, month, day);
      const isPast = date < new Date(today.getFullYear(), today.getMonth(), today.getDate());
      const isSunday = false;
      const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      const isBusy = busyDays.has(day);
      const isSelected = selectedDay === dateStr;

      let classes = 'aspect-square flex items-center justify-center font-[\'Space_Mono\'] text-xs cursor-pointer transition-all duration-200 ';

      if (isPast) {
        classes += 'text-gray-700 cursor-not-allowed';
      } else if (isSelected) {
        classes += 'bg-[#BFFF00] text-black font-bold';
      } else if (isBusy) {
        classes += 'bg-red-500/20 text-red-400 border border-red-500/30 hover:bg-red-500/30';
      } else {
        classes += 'text-white hover:bg-[#BFFF00]/20 hover:text-[#BFFF00] border border-white/10';
      }

      grid.innerHTML += `
        <div class="${classes}" data-date="${dateStr}" data-disabled="${isPast || isSunday}">
          ${day}
        </div>
      `;
    }

    // Eventos en los días
    grid.querySelectorAll('[data-date]').forEach(el => {
      if (el.getAttribute('data-disabled') === 'true') return;
      el.addEventListener('click', () => {
        selectedDay = el.getAttribute('data-date');
        renderCalendar();
        renderHours(selectedDay!);
      });
    });
  }

  function renderHours(dateStr: string) {
    const busyHours = getBusyHours(dateStr);
    const hoursGrid = document.getElementById('hours-grid')!;
    const cta = document.getElementById('reserve-cta')!;

    const [year, month, day] = dateStr.split('-');
    document.getElementById('selected-date-title')!.textContent =
      `${day} DE ${MONTHS[parseInt(month) - 1].toUpperCase()}`;

    hoursGrid.innerHTML = HOURS.map(hour => {
      const isBusy = busyHours.includes(hour);
      return `
        <div class="text-center py-2 font-['Space_Mono'] text-xs tracking-widest border transition-colors ${
          isBusy
            ? 'bg-red-500/10 border-red-500/30 text-red-400 cursor-not-allowed'
            : 'border-white/10 text-white hover:border-[#BFFF00] hover:text-[#BFFF00] cursor-pointer'
        }">
          ${hour}
        </div>
      `;
    }).join('');

    cta.classList.remove('hidden');
  }

  // Navegación de meses
  document.getElementById('prev-month')?.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    selectedDay = null;
    renderCalendar();
    document.getElementById('hours-grid')!.innerHTML =
      '<p class="col-span-3 font-[\'Space_Mono\'] text-xs text-gray-600 text-center py-8">Toca un día disponible para ver los horarios</p>';
    document.getElementById('selected-date-title')!.textContent = 'SELECCIONA UN DÍA';
    document.getElementById('reserve-cta')!.classList.add('hidden');
  });

  document.getElementById('next-month')?.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    selectedDay = null;
    renderCalendar();
    document.getElementById('hours-grid')!.innerHTML =
      '<p class="col-span-3 font-[\'Space_Mono\'] text-xs text-gray-600 text-center py-8">Toca un día disponible para ver los horarios</p>';
    document.getElementById('selected-date-title')!.textContent = 'SELECCIONA UN DÍA';
    document.getElementById('reserve-cta')!.classList.add('hidden');
  });

  renderCalendar();
</script>