---
// Hero.astro — El Balcón Barber Studio
---

<section id="inicio" class="relative min-h-screen flex items-center justify-center overflow-hidden">

  <!-- Video de fondo -->
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover"
  >
    <source src="/images/movie-Barber.mp4" type="video/mp4" />
  </video>

  <!-- Overlay oscuro sobre el video -->
  <div class="absolute inset-0 bg-black/70"></div>

  <!-- Línea de acento decorativa -->
  <div class="absolute top-0 left-0 w-full h-1 bg-[#BFFF00]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 pt-20 w-full">
    <div class="grid md:grid-cols-2 gap-12 items-center">

      <!-- Texto -->
      <div class="space-y-6">

        <!-- Badge de estatus -->
        <div id="status-badge" class="inline-flex items-center gap-2 bg-[#BFFF00]/10 border border-[#BFFF00]/30 px-4 py-1.5">
          <span id="status-dot" class="w-2 h-2 bg-[#BFFF00] rounded-full animate-pulse"></span>
          <span id="status-text" class="font-['Space_Mono'] text-xs text-[#BFFF00] tracking-widest uppercase">
            Abierto hoy · 9am – 8pm
          </span>
        </div>

        <!-- Título -->
        <h1 class="font-['Bebas_Neue'] text-7xl md:text-8xl leading-none tracking-wider">
          EL BALCÓN<br /><span class="text-[#BFFF00]">BARBER STUDIO</span>
        </h1>

        <!-- Descripción -->
        <p class="text-lg text-gray-300 max-w-md leading-relaxed">
          No solo un corte. Una <span class="text-white font-semibold">identidad</span>.
          Barbería urbana donde el estilo se encuentra con la precisión artesanal.
        </p>

        <!-- Botones -->
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="#reservar" class="bg-[#BFFF00] text-black font-bold px-8 py-4 text-sm tracking-widest uppercase hover:bg-[#BFFF00]/80 transition-colors">
            Reservar Cita →
          </a>
          <a href="#servicios" class="border border-white/40 text-white px-8 py-4 text-sm tracking-widest uppercase hover:border-[#BFFF00] hover:text-[#BFFF00] transition-colors">
            Ver Servicios
          </a>
        </div>

        <!-- Stats -->
        <div class="flex gap-10 pt-6 border-t border-white/20">
          <div>
            <p class="font-['Bebas_Neue'] text-4xl text-[#BFFF00]">8+</p>
            <p class="font-['Space_Mono'] text-xs text-gray-400 uppercase tracking-widest">Años de exp.</p>
          </div>
          <div>
            <p class="font-['Bebas_Neue'] text-4xl text-[#BFFF00]">500+</p>
            <p class="font-['Space_Mono'] text-xs text-gray-400 uppercase tracking-widest">Clientes</p>
          </div>
          <div>
            <p class="font-['Bebas_Neue'] text-4xl text-[#BFFF00]">4.9★</p>
            <p class="font-['Space_Mono'] text-xs text-gray-400 uppercase tracking-widest">Calificación</p>
          </div>
        </div>

      </div>

      <!-- Logo -->
      <div class="hidden md:flex justify-center items-center">
        <div class="relative flex items-center justify-center">

          <!-- Círculos decorativos -->
          <div class="absolute w-72 h-72 rounded-full border border-[#BFFF00]/20"></div>
          <div class="absolute w-56 h-56 rounded-full border border-[#BFFF00]/10"></div>

          <!-- Logo con mix-blend-mode para quitar el fondo blanco -->
          <img
            src="/images/logo-barber.jpeg"
            alt="El Balcón Barber Studio"
            class="relative z-10 w-52 h-52 object-cover rounded-full border-2 border-[#BFFF00]/40"
          />

        </div>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
    <span class="font-['Space_Mono'] text-xs text-gray-400 uppercase tracking-widest">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-gray-400 to-transparent"></div>
  </div>

</section>

<script>
  const savedStatus = localStorage.getItem('barber_status') ?? 'open';

  const badge = document.getElementById('status-badge');
  const dot = document.getElementById('status-dot');
  const text = document.getElementById('status-text');

  function applyStatus(status: string) {
    if (status === 'open') {
      badge?.classList.remove('bg-red-500/10', 'border-red-500/30');
      badge?.classList.add('bg-[#BFFF00]/10', 'border-[#BFFF00]/30');
      dot?.classList.remove('bg-red-500');
      dot?.classList.add('bg-[#BFFF00]');
      if (text) text.textContent = 'Abierto hoy · 9am – 8pm';
      text?.classList.remove('text-red-400');
      text?.classList.add('text-[#BFFF00]');
    } else {
      badge?.classList.add('bg-red-500/10', 'border-red-500/30');
      badge?.classList.remove('bg-[#BFFF00]/10', 'border-[#BFFF00]/30');
      dot?.classList.add('bg-red-500');
      dot?.classList.remove('bg-[#BFFF00]');
      if (text) text.textContent = 'Cerrado por hoy';
      text?.classList.add('text-red-400');
      text?.classList.remove('text-[#BFFF00]');
    }
  }

  applyStatus(savedStatus);

  window.addEventListener('storage', (e) => {
    if (e.key === 'barber_status') applyStatus(e.newValue ?? 'open');
  });

  window.addEventListener('statusChanged', (e: any) => {
    applyStatus(e.detail.status);
  });
</script>