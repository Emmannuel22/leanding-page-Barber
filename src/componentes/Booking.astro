---
// Booking.astro — Formulario de reserva
---

<section id="reservar" class="py-24 bg-[#0A0A0A]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-16 items-start">

      <!-- Lado izquierdo: info -->
      <div class="space-y-8">
        <div>
          <p class="font-['Space_Mono'] text-xs text-[#BFFF00] tracking-widest uppercase mb-3">— Agenda tu turno</p>
          <h2 class="font-['Bebas_Neue'] text-6xl md:text-7xl text-white leading-none">
            RESERVA<br /><span class="text-[#BFFF00]">TU CITA</span>
          </h2>
        </div>

        <p class="text-gray-400 leading-relaxed">
          Sin esperas. Sin sorpresas. Agenda en línea y llega listo para tu transformación.
        </p>

        <!-- Horarios -->
        <div class="space-y-2">
          <p class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest mb-4">Horarios de atención</p>
          {[
            { days: 'Lunes — Viernes', hours: '10:00 AM – 8:00 PM' },
            { days: 'Sábado', hours: '10:00 AM – 8:00 PM' },
            { days: 'Domingo', hours: '12:00 PM – 7:00 PM' },
          ].map(h => (
            <div class="flex justify-between items-center py-3 border-b border-white/10">
              <span class="text-sm text-white">{h.days}</span>
              <span class="font-['Space_Mono'] text-xs text-[#BFFF00] tracking-widest">{h.hours}</span>
            </div>
          ))}
        </div>

        <!-- Contacto alternativo -->
        <div class="bg-[#111] border border-white/10 p-6 space-y-3">
          <p class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest mb-2">También puedes reservar por</p>
          <a href="https://wa.me/5215517372164" target="_blank"
            class="flex items-center gap-3 text-white hover:text-[#BFFF00] transition-colors text-sm">
            📱 WhatsApp: +52 55 7370 2164
          </a>
          <a href="tel:+5215517372164"
            class="flex items-center gap-3 text-white hover:text-[#BFFF00] transition-colors text-sm">
            📞 Llamada: +52 55 7370 2164
          </a>
        </div>
      </div>

      <!-- Lado derecho: formulario -->
      <div class="bg-[#111] border border-white/10 p-8 space-y-5">
        <p class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Completa el formulario</p>

        <!-- Nombre -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Nombre completo</label>
          <input type="text" id="name" placeholder="Tu nombre"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#BFFF00] transition-colors placeholder-gray-700"
          />
        </div>

        <!-- Teléfono -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Teléfono</label>
          <input type="tel" id="phone" placeholder="+52 55 0000 0000"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#BFFF00] transition-colors placeholder-gray-700"
          />
        </div>

        <!-- Email -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Correo electrónico</label>
          <input type="email" id="email" placeholder="tu@correo.com"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#BFFF00] transition-colors placeholder-gray-700"
          />
        </div>
        
        <!-- Número de personas -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">¿Para cuántas personas?</label>
          <select id="persons"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#BFFF00] transition-colors cursor-pointer"
          >
            <option value="1">1 persona</option>
            <option value="2">2 personas</option>
          </select>
        </div>

        <!-- Servicio -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Servicio</label>
          <select id="service"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#BFFF00] transition-colors cursor-pointer"
          >
            <option value="" disabled selected>Selecciona un servicio</option>
            <option value="corte_clasico">Corte Clásico — $120</option>
            <option value="corte_fade">Corte Fade — $140</option>
            <option value="corte_fade_barba">Corte Fade + Barba — $240</option>
            <option value="corte_clasico_barba">Corte Clásico + Barba — $220</option>
            <option value="barba">Arreglo de Barba — $100</option>
            <option value="cejascorte">Cejas — $40</option>
          </select>
        </div>

        <!-- Fecha y Hora -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1">
            <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Fecha</label>
            <input type="date" id="date"
              class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#BFFF00] transition-colors [color-scheme:dark]"
            />
          </div>
          <div class="space-y-1">
            <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Hora</label>
            <select id="time"
              class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#BFFF00] transition-colors cursor-pointer"
            >
              <option value="" disabled selected>Hora</option>
              {['10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00', '19:00', '20:00'].map(t => (
                <option value={t}>{t} hrs</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Productos opcionales — dinámico desde Supabase -->
        <div class="space-y-2">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Productos opcionales</label>
          <p class="font-['Space_Mono'] text-xs text-gray-700">Agrega un producto a tu cita (opcional)</p>
          <div id="products-grid" class="grid grid-cols-2 gap-3">
            <p class="col-span-2 font-['Space_Mono'] text-xs text-gray-600 text-center py-4">Cargando productos...</p>
          </div>
        </div>

        <!-- Notas -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Notas adicionales</label>
          <textarea id="notes" rows="3" placeholder="¿Algo específico que debamos saber?"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#BFFF00] transition-colors placeholder-gray-700 resize-none"
          ></textarea>
        </div>

        <!-- Aviso de cerrado -->
        <div id="closed-warning" class="hidden bg-red-500/10 border border-red-500/30 p-4 text-center">
          <p class="font-['Space_Mono'] text-xs text-red-400 tracking-widest uppercase">
            🔒 La barbería está cerrada en este momento. No se pueden realizar reservas.
          </p>
        </div>

        <!-- Botón -->
        <button id="submit-btn" type="button"
          class="w-full bg-[#BFFF00] text-black font-bold py-4 text-sm tracking-widest uppercase hover:bg-[#BFFF00]/80 transition-colors"
        >
          Confirmar Reserva →
        </button>

        <!-- Mensaje éxito -->
        <div id="success-msg" class="hidden text-center py-4">
          <p class="font-['Bebas_Neue'] text-2xl text-[#BFFF00] mb-1">¡RESERVA ENVIADA!</p>
          <p class="font-['Space_Mono'] text-xs text-gray-500">Te contactaremos para confirmar tu cita.</p>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  import emailjs from '@emailjs/browser';
  import { supabase } from '../lib/supabase';

  const SERVICE_ID = 'service_nfn5u5n';
  const TEMPLATE_ID = 'template_4v2a2yh';
  const PUBLIC_KEY = 'Nx4lOSt5UZixEHNfh';

  emailjs.init(PUBLIC_KEY);

  const btn = document.getElementById('submit-btn');
  const successMsg = document.getElementById('success-msg');

  // Cargar productos desde Supabase
  async function loadProducts() {
    const { data: products, error } = await supabase
      .from('productos')
      .select('*')
      .order('id');

    if (error || !products) return;

    const grid = document.getElementById('products-grid')!;
    grid.innerHTML = products.map(p => `
      <label class="relative cursor-pointer">
        <input
          type="checkbox"
          id="product-${p.id}"
          value="${p.name}"
          data-price="${p.price}"
          ${p.stock === 0 ? 'disabled' : ''}
          class="peer hidden"
        />
        <div class="border p-3 transition-all duration-300 ${
          p.stock === 0
            ? 'border-white/5 opacity-50 cursor-not-allowed'
            : 'border-white/10 cursor-pointer peer-checked:border-[#BFFF00] peer-checked:bg-[#BFFF00]/5'
        }">
          <img src="${p.image}" alt="${p.name}" class="w-full h-24 object-cover mb-2" />
          <p class="font-['Space_Mono'] text-xs text-white">${p.name}</p>
          <div class="flex items-center justify-between mt-1">
            <p class="font-['Bebas_Neue'] text-lg text-[#BFFF00]">$${p.price}</p>
            ${p.stock === 0
              ? '<span class="font-mono text-xs text-red-400">AGOTADO</span>'
              : `<span class="font-mono text-xs text-gray-600">${p.stock} pzs</span>`
            }
          </div>
        </div>
      </label>
    `).join('');
  }

  loadProducts();

  // Estatus abierto/cerrado
  function checkStatus() {
    const status = localStorage.getItem('barber_status') ?? 'open';
    if (status === 'closed') blockForm();
    else unblockForm();
  }

  function blockForm() {
    if (!btn) return;
    (btn as HTMLButtonElement).disabled = true;
    btn.textContent = '🔒 Reservas no disponibles';
    btn.classList.add('opacity-50', 'cursor-not-allowed');
    document.getElementById('closed-warning')?.classList.remove('hidden');
  }

  function unblockForm() {
    if (!btn) return;
    (btn as HTMLButtonElement).disabled = false;
    btn.textContent = 'Confirmar Reserva →';
    btn.classList.remove('opacity-50', 'cursor-not-allowed');
    document.getElementById('closed-warning')?.classList.add('hidden');
  }

  checkStatus();

  window.addEventListener('storage', (e) => {
    if (e.key === 'barber_status') checkStatus();
  });

  window.addEventListener('statusChanged', (e: any) => {
    if (e.detail.status === 'closed') blockForm();
    else unblockForm();
  });

  btn?.addEventListener('click', async () => {
    const status = localStorage.getItem('barber_status') ?? 'open';
    if (status === 'closed') return;

    const name = (document.getElementById('name') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
    const service = (document.getElementById('service') as HTMLSelectElement)?.value;
    const date = (document.getElementById('date') as HTMLInputElement)?.value;
    const time = (document.getElementById('time') as HTMLSelectElement)?.value;
    const notes = (document.getElementById('notes') as HTMLTextAreaElement)?.value.trim();
    const persons = (document.getElementById('persons') as HTMLSelectElement)?.value;

    // Capturar productos seleccionados dinámicamente
    const selectedProducts = Array.from(
      document.querySelectorAll('[id^="product-"]:checked')
    ).map((el: any) => `${el.value} ($${el.dataset.price})`).join(', ') || 'Ninguno';

    if (!name || !phone || !email || !service || !date || !time) {
      alert('Por favor completa todos los campos requeridos.');
      return;
    }

    // Validar fecha y hora
    const now = new Date();
    const [year, month, day] = date.split('-').map(Number);
    const [hour] = time.split(':').map(Number);
    const selectedDate = new Date(year, month - 1, day, hour, 0, 0, 0);
    const minAllowed = new Date(now.getTime() + 60 * 60 * 1000);

    if (selectedDate < minAllowed) {
      alert('⚠️ Elige un horario con al menos 1 hora de anticipación.');
      return;
    }

    // Verificar hora ocupada en Supabase
    const { data: existing } = await supabase
      .from('appointments')
      .select('id')
      .eq('date', date)
      .eq('time', time)
      .neq('status', 'rejected');

    if (existing && existing.length > 0) {
      alert('⚠️ Ese horario ya está reservado. Por favor elige otra hora.');
      return;
    }

    (btn as HTMLButtonElement).disabled = true;
    btn.textContent = 'Enviando...';

    try {
      // Guardar en Supabase
      const { error } = await supabase.from('appointments').insert({
        name, phone, email, service, date, time,
        persons: parseInt(persons),
        notes: notes || null,
        products: selectedProducts,
        status: 'pending',
      });

      if (error) throw error;

      // Enviar email al dueño
      await emailjs.send(SERVICE_ID, TEMPLATE_ID, {
        client_name: name,
        client_phone: phone,
        service, date, time, persons,
        notes: notes || 'Sin notas',
        products: selectedProducts,
      });

      setTimeout(() => {
        btn?.classList.add('hidden');
        successMsg?.classList.remove('hidden');
      }, 500);

    } catch (error) {
      console.error('Error completo:', JSON.stringify(error));
      alert('⚠️ Hubo un error al enviar la reserva. Intenta de nuevo.');
      (btn as HTMLButtonElement).disabled = false;
      btn.textContent = 'Confirmar Reserva →';
    }
  });
</script>