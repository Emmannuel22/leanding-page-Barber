---
// Booking.astro — Formulario de reserva
---

<section id="reservar" class="py-24 bg-[#0A0A0A]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-16 items-start">

      <!-- Lado izquierdo: info -->
      <div class="space-y-8">
        <div>
          <p class="font-['Space_Mono'] text-xs text-[#F5C518] tracking-widest uppercase mb-3">— Agenda tu turno</p>
          <h2 class="font-['Bebas_Neue'] text-6xl md:text-7xl text-white leading-none">
            RESERVA<br /><span class="text-[#F5C518]">TU CITA</span>
          </h2>
        </div>

        <p class="text-gray-400 leading-relaxed">
          Sin esperas. Sin sorpresas. Agenda en línea y llega listo para tu transformación.
        </p>

        <!-- Horarios -->
        <div class="space-y-2">
          <p class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest mb-4">Horarios de atención</p>
          {[
            { days: 'Lunes — Viernes', hours: '9:00 AM – 8:00 PM' },
            { days: 'Sábado', hours: '9:00 AM – 7:00 PM' },
            { days: 'Domingo', hours: '10:00 AM – 4:00 PM' },
          ].map(h => (
            <div class="flex justify-between items-center py-3 border-b border-white/10">
              <span class="text-sm text-white">{h.days}</span>
              <span class="font-['Space_Mono'] text-xs text-[#F5C518] tracking-widest">{h.hours}</span>
            </div>
          ))}
        </div>

        <!-- Contacto alternativo -->
        <div class="bg-[#111] border border-white/10 p-6 space-y-3">
          <p class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest mb-2">También puedes reservar por</p>
          <a href="https://wa.me/5215512345678" target="_blank"
            class="flex items-center gap-3 text-white hover:text-[#F5C518] transition-colors text-sm">
            📱 WhatsApp: +52 55 7370 2164
          </a>
          <a href="tel:+5215512345678"
            class="flex items-center gap-3 text-white hover:text-[#F5C518] transition-colors text-sm">
            📞 Llamada: +52 55 7370 2164
          </a>
        </div>
      </div>

      <!-- Lado derecho: formulario -->
      <div class="bg-[#111] border border-white/10 p-8 space-y-5">
        <p class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Completa el formulario</p>

        <!-- Nombre -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Nombre completo</label>
          <input
            type="text"
            id="name"
            placeholder="Tu nombre"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#F5C518] transition-colors placeholder-gray-700"
          />
        </div>

        <!-- Teléfono -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Teléfono</label>
          <input
            type="tel"
            id="phone"
            placeholder="+52 55 0000 0000"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#F5C518] transition-colors placeholder-gray-700"
          />
        </div>

        <!-- Servicio -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Servicio</label>
          <select
            id="service"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#F5C518] transition-colors cursor-pointer"
          >
            <option value="" disabled selected>Selecciona un servicio</option>
            <option value="corte">Corte Clásico — $120</option>
            <option value="afeitado">Corte Fade — $140</option>
            <option value="combo">Arreglo de Barba — $100</option>
            <option value="color">Cejas $40</option>
          </select>
        </div>

        <!-- Fecha y Hora -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1">
            <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Fecha</label>
            <input
              type="date"
              id="date"
              class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#F5C518] transition-colors [color-scheme:dark]"
            />
          </div>
          <div class="space-y-1">
            <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Hora</label>
            <select
              id="time"
              class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#F5C518] transition-colors cursor-pointer"
            >
              <option value="" disabled selected>Hora</option>
              {['9:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00', '19:00'].map(t => (
                <option value={t}>{t} hrs</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Notas -->
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Notas adicionales</label>
          <textarea
            id="notes"
            rows="3"
            placeholder="¿Algo específico que debamos saber?"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#F5C518] transition-colors placeholder-gray-700 resize-none"
          ></textarea>
        </div>

        <!-- Botón -->
        <button
          id="submit-btn"
          type="button"
          class="w-full bg-[#F5C518] text-black font-bold py-4 text-sm tracking-widest uppercase hover:bg-[#FF6B1A] transition-colors duration-300"
        >
          Confirmar Reserva →
        </button>

        <!-- Mensaje éxito -->
        <div id="success-msg" class="hidden text-center py-4">
          <p class="font-['Bebas_Neue'] text-2xl text-[#F5C518] mb-1">¡RESERVA ENVIADA!</p>
          <p class="font-['Space_Mono'] text-xs text-gray-500">Te contactaremos para confirmar tu cita.</p>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('submit-btn');
  const successMsg = document.getElementById('success-msg');

  btn?.addEventListener('click', () => {
    const name = (document.getElementById('name') as HTMLInputElement)?.value;
    const phone = (document.getElementById('phone') as HTMLInputElement)?.value;
    const service = (document.getElementById('service') as HTMLSelectElement)?.value;
    const date = (document.getElementById('date') as HTMLInputElement)?.value;
    const time = (document.getElementById('time') as HTMLSelectElement)?.value;

    if (!name || !phone || !service || !date || !time) {
      alert('Por favor completa todos los campos requeridos.');
      return;
    }

    btn.textContent = 'Enviando...';
    (btn as HTMLButtonElement).disabled = true;

    setTimeout(() => {
      btn.classList.add('hidden');
      successMsg?.classList.remove('hidden');
    }, 1200);
  });
</script>