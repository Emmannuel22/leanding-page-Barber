---
// Admin.astro — Panel del dueño
---

<!-- Botón flotante -->
<button
  id="admin-btn"
  class="fixed bottom-6 right-6 z-50 bg-[#1A1A1A] border border-white/20 text-white w-12 h-12 flex items-center justify-center hover:border-[#BFFF00] hover:text-[#BFFF00] transition-all duration-300"
  aria-label="Panel admin"
>
  🔐
</button>

<!-- Modal -->
<div id="admin-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center px-4">
  <div class="bg-[#111] border border-white/10 w-full max-w-lg p-8 relative max-h-[90vh] overflow-y-auto">

    <!-- Cerrar -->
    <button id="close-modal" class="absolute top-4 right-4 text-gray-500 hover:text-white transition-colors text-xl">✕</button>

    <!-- Login -->
    <div id="login-panel">
      <p class="font-['Space_Mono'] text-xs text-[#BFFF00] tracking-widest uppercase mb-2">— Acceso restringido</p>
      <h2 class="font-['Bebas_Neue'] text-4xl text-white mb-6">PANEL DEL DUEÑO</h2>
      <div class="space-y-4">
        <div class="space-y-1">
          <label class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Contraseña</label>
          <input
            type="password"
            id="admin-password"
            placeholder="••••••••"
            class="w-full bg-[#0A0A0A] border border-white/10 text-white text-sm px-4 py-3 focus:outline-none focus:border-[#BFFF00] transition-colors placeholder-gray-700"
          />
        </div>
        <button id="login-btn" class="w-full bg-[#BFFF00] text-black font-bold py-3 text-sm tracking-widest uppercase hover:bg-[#BFFF00]/80 transition-colors">
          Entrar →
        </button>
        <p id="login-error" class="hidden font-['Space_Mono'] text-xs text-red-400 text-center">Contraseña incorrecta</p>
      </div>
    </div>

    <!-- Panel de control -->
    <div id="control-panel" class="hidden space-y-8">
      <div>
        <p class="font-['Space_Mono'] text-xs text-[#BFFF00] tracking-widest uppercase mb-2">— Bienvenido</p>
        <h2 class="font-['Bebas_Neue'] text-4xl text-white">PANEL DE CONTROL</h2>
      </div>

      <!-- Estatus -->
      <div class="bg-[#0A0A0A] border border-white/10 p-6">
        <p class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest mb-4">Estado de la barbería</p>
        <div class="flex items-center justify-between">
          <div>
            <p id="status-label" class="font-['Bebas_Neue'] text-2xl text-white">ABIERTO</p>
            <p class="font-['Space_Mono'] text-xs text-gray-600">Se muestra en la página principal</p>
          </div>
          <button id="status-toggle" class="relative w-14 h-7 bg-[#BFFF00] rounded-full transition-colors duration-300">
            <span id="toggle-circle" class="absolute top-0.5 right-0.5 w-6 h-6 bg-black rounded-full transition-all duration-300"></span>
          </button>
        </div>
      </div>

      <!-- Stock de productos -->
      <div class="bg-[#0A0A0A] border border-white/10 p-6 space-y-4">
        <p class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Stock de productos</p>
        <div id="products-stock" class="space-y-3">
          <p class="font-['Space_Mono'] text-xs text-gray-600">Cargando...</p>
        </div>
      </div>

      <!-- Citas -->
      <div class="flex items-center justify-between">
        <p class="font-['Space_Mono'] text-xs text-gray-500 uppercase tracking-widest">Citas por día</p>
        <p id="last-update" class="font-['Space_Mono'] text-xs text-gray-700">Actualizando...</p>
      </div>

      <!-- Pestañas de días -->
      <div id="day-tabs" class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide"></div>

      <!-- Contenido del día -->
      <div id="day-content" class="space-y-3"></div>

      <!-- Cerrar sesión -->
      <button id="logout-btn" class="w-full border border-white/10 text-gray-500 py-3 text-xs font-['Space_Mono'] tracking-widest uppercase hover:border-red-500 hover:text-red-400 transition-colors">
        Cerrar sesión
      </button>
    </div>

  </div>
</div>

<script>
  const adminBtn = document.getElementById('admin-btn');
  const modal = document.getElementById('admin-modal');
  const closeModal = document.getElementById('close-modal');
  const loginPanel = document.getElementById('login-panel');
  const controlPanel = document.getElementById('control-panel');
  const loginBtn = document.getElementById('login-btn');
  const loginError = document.getElementById('login-error');
  const logoutBtn = document.getElementById('logout-btn');
  const statusToggle = document.getElementById('status-toggle');
  const statusLabel = document.getElementById('status-label');
  const toggleCircle = document.getElementById('toggle-circle');

  let isOpen = localStorage.getItem('barber_status') !== 'closed';
  let selectedDay = getTodayStr();
  let pollingInterval: any = null;

  function getTodayStr() {
    const now = new Date();
    return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  }

  function formatTabDate(dateStr: string) {
    const [year, month, day] = dateStr.split('-').map(Number);
    const date = new Date(year, month - 1, day);
    const today = getTodayStr();
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tomorrowStr = `${tomorrow.getFullYear()}-${String(tomorrow.getMonth() + 1).padStart(2, '0')}-${String(tomorrow.getDate()).padStart(2, '0')}`;

    if (dateStr === today) return { top: 'HOY', bottom: date.toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }).toUpperCase() };
    if (dateStr === tomorrowStr) return { top: 'MAÑANA', bottom: date.toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }).toUpperCase() };
    return {
      top: date.toLocaleDateString('es-MX', { weekday: 'short' }).toUpperCase(),
      bottom: date.toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }).toUpperCase(),
    };
  }

  function formatFullDate(dateStr: string) {
    const [year, month, day] = dateStr.split('-').map(Number);
    const date = new Date(year, month - 1, day);
    return date.toLocaleDateString('es-MX', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
    }).toUpperCase();
  }

  // Abrir modal
  adminBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));

  // Cerrar modal
  closeModal?.addEventListener('click', () => modal?.classList.add('hidden'));
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
  });

  // Login — solo manda la contraseña una vez
  loginBtn?.addEventListener('click', async () => {
    const input = (document.getElementById('admin-password') as HTMLInputElement)?.value;

    const res = await fetch('/api/auth', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: input }),
    });

    if (res.ok) {
      loginPanel?.classList.add('hidden');
      controlPanel?.classList.remove('hidden');
      loginError?.classList.add('hidden');
      updateToggleUI();
      loadProducts();
      loadAppointments();
      pollingInterval = setInterval(() => loadAppointments(), 30000);
    } else {
      loginError?.classList.remove('hidden');
    }
  });

  document.getElementById('admin-password')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') loginBtn?.click();
  });

  // Logout — elimina la cookie de sesión
  logoutBtn?.addEventListener('click', async () => {
    await fetch('/api/auth', { method: 'DELETE' });
    controlPanel?.classList.add('hidden');
    loginPanel?.classList.remove('hidden');
    (document.getElementById('admin-password') as HTMLInputElement).value = '';
    modal?.classList.add('hidden');
    if (pollingInterval) clearInterval(pollingInterval);
  });

  // Toggle estatus
  function updateToggleUI() {
    if (isOpen) {
      statusToggle?.classList.add('bg-[#BFFF00]');
      statusToggle?.classList.remove('bg-gray-700');
      toggleCircle?.classList.add('right-0.5');
      toggleCircle?.classList.remove('left-0.5');
      if (statusLabel) statusLabel.textContent = 'ABIERTO';
    } else {
      statusToggle?.classList.remove('bg-[#BFFF00]');
      statusToggle?.classList.add('bg-gray-700');
      toggleCircle?.classList.remove('right-0.5');
      toggleCircle?.classList.add('left-0.5');
      if (statusLabel) statusLabel.textContent = 'CERRADO';
    }
  }

  statusToggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    const newStatus = isOpen ? 'open' : 'closed';
    localStorage.setItem('barber_status', newStatus);
    updateToggleUI();
    window.dispatchEvent(new CustomEvent('statusChanged', { detail: { status: newStatus } }));
  });

  // Cargar productos desde API
  async function loadProducts() {
    try {
      const res = await fetch('/api/products');
      const products = await res.json();

      const stockEl = document.getElementById('products-stock')!;
      stockEl.innerHTML = products.map((p: any) => `
        <div class="flex items-center justify-between py-3 border-b border-white/10">
          <div class="flex items-center gap-3">
            <img src="${p.image}" alt="${p.name}" class="w-10 h-10 object-cover" />
            <div>
              <p class="font-['Space_Mono'] text-xs text-white">${p.name}</p>
              <p class="font-['Space_Mono'] text-xs text-gray-600">$${p.price}</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button
              onclick="updateStock(${p.id}, ${p.stock - 1})"
              class="w-7 h-7 border border-white/10 text-white hover:border-red-400 hover:text-red-400 transition-colors flex items-center justify-center font-bold"
              ${p.stock === 0 ? 'disabled' : ''}
            >−</button>
            <span class="font-['Bebas_Neue'] text-xl w-8 text-center ${p.stock === 0 ? 'text-red-400' : 'text-[#BFFF00]'}">${p.stock}</span>
            <button
              onclick="updateStock(${p.id}, ${p.stock + 1})"
              class="w-7 h-7 border border-white/10 text-white hover:border-[#BFFF00] hover:text-[#BFFF00] transition-colors flex items-center justify-center font-bold"
            >+</button>
            <span class="font-['Space_Mono'] text-xs ml-2 ${p.stock === 0 ? 'text-red-400' : 'text-gray-600'}">
              ${p.stock === 0 ? 'AGOTADO' : 'pzs'}
            </span>
          </div>
        </div>
      `).join('');
    } catch (error) {
      console.error('Error cargando productos:', error);
    }
  }

  // Actualizar stock — sin contraseña, usa cookie
  (window as any).updateStock = async (id: number, newStock: number) => {
    if (newStock < 0) return;
    try {
      const res = await fetch('/api/products', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, stock: newStock }),
      });
      if (!res.ok) throw new Error('Error actualizando stock');
      loadProducts();
    } catch (error) {
      console.error('Error:', error);
    }
  };

  // Cargar citas desde API
  async function loadAppointments() {
    try {
      const today = getTodayStr();
      const res = await fetch(`/api/appointments?date=${today}`);
      const appointments = await res.json();

      const lastUpdate = document.getElementById('last-update');
      if (lastUpdate) {
        const now = new Date();
        lastUpdate.textContent = `Actualizado ${now.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' })}`;
      }

      if (!appointments || appointments.length === 0) {
        document.getElementById('day-tabs')!.innerHTML = '';
        document.getElementById('day-content')!.innerHTML =
          '<p class="font-[\'Space_Mono\'] text-xs text-gray-600 text-center py-8">No hay citas próximas</p>';
        return;
      }

      const grouped: Record<string, any[]> = {};
      appointments.forEach((apt: any) => {
        if (!grouped[apt.date]) grouped[apt.date] = [];
        grouped[apt.date].push(apt);
      });

      const sortedDays = Object.keys(grouped).sort();
      if (!grouped[selectedDay]) selectedDay = sortedDays[0];

      const tabsEl = document.getElementById('day-tabs')!;
      tabsEl.innerHTML = sortedDays.map(day => {
        const label = formatTabDate(day);
        const isActive = day === selectedDay;
        const pendingCount = grouped[day].filter((a: any) => a.status === 'pending').length;
        return `
          <button data-day="${day}" class="day-tab flex-shrink-0 flex flex-col items-center px-4 py-2 border transition-all duration-200 ${
            isActive
              ? 'border-[#BFFF00] bg-[#BFFF00]/10 text-[#BFFF00]'
              : 'border-white/10 text-gray-500 hover:border-white/30 hover:text-white'
          }">
            <span class="font-['Bebas_Neue'] text-sm tracking-widest">${label.top}</span>
            <span class="font-['Space_Mono'] text-xs">${label.bottom}</span>
            ${pendingCount > 0 ? `<span class="mt-1 w-4 h-4 bg-yellow-400 text-black text-xs font-bold rounded-full flex items-center justify-center">${pendingCount}</span>` : ''}
          </button>
        `;
      }).join('');

      tabsEl.querySelectorAll('.day-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          selectedDay = tab.getAttribute('data-day')!;
          loadAppointments();
        });
      });

      const dayAppointments = grouped[selectedDay] ?? [];
      const contentEl = document.getElementById('day-content')!;

      contentEl.innerHTML = `
        <p class="font-['Space_Mono'] text-xs text-gray-600 mb-3">${formatFullDate(selectedDay)}</p>
        ${dayAppointments.length === 0
          ? '<p class="font-[\'Space_Mono\'] text-xs text-gray-600 text-center py-4">Sin citas este día</p>'
          : dayAppointments.map((apt: any) => `
              <div class="bg-[#0A0A0A] border border-white/10 p-4 space-y-2 mb-3">
                <div class="flex justify-between items-start">
                  <div class="space-y-1">
                    <p class="font-['Bebas_Neue'] text-lg text-white">${apt.name}</p>
                    <p class="font-['Space_Mono'] text-xs text-[#BFFF00]">⏰ ${apt.time} hrs</p>
                    <p class="font-['Space_Mono'] text-xs text-gray-500">✂️ ${apt.service}</p>
                    <p class="font-['Space_Mono'] text-xs text-gray-500">👥 ${apt.persons ?? 1} persona(s)</p>
                    <p class="font-['Space_Mono'] text-xs text-gray-600">📞 ${apt.phone}</p>
                    <p class="font-['Space_Mono'] text-xs text-gray-600">📧 ${apt.email ?? 'Sin correo'}</p>
                    ${apt.products && apt.products !== 'Ninguno' ? `<p class="font-['Space_Mono'] text-xs text-[#BFFF00]/70">🛍️ ${apt.products}</p>` : ''}
                    ${apt.notes ? `<p class="font-['Space_Mono'] text-xs text-gray-700">📝 ${apt.notes}</p>` : ''}
                  </div>
                  <span class="font-['Space_Mono'] text-xs px-2 py-1 ${
                    apt.status === 'pending' ? 'bg-yellow-500/10 text-yellow-400 border border-yellow-500/30' :
                    apt.status === 'accepted' ? 'bg-[#BFFF00]/10 text-[#BFFF00] border border-[#BFFF00]/30' :
                    'bg-red-500/10 text-red-400 border border-red-500/30'
                  }">${
                    apt.status === 'pending' ? 'PENDIENTE' :
                    apt.status === 'accepted' ? 'ACEPTADA' : 'RECHAZADA'
                  }</span>
                </div>
                ${apt.status === 'pending' ? `
                <div class="flex gap-2 pt-1">
                  <button onclick="updateAppointment('${apt.id}', 'accepted')" class="flex-1 bg-[#BFFF00]/10 border border-[#BFFF00]/30 text-[#BFFF00] font-['Space_Mono'] text-xs py-2 tracking-widest uppercase hover:bg-[#BFFF00]/20 transition-colors">
                    ✓ Aceptar
                  </button>
                  <button onclick="updateAppointment('${apt.id}', 'rejected')" class="flex-1 bg-red-500/10 border border-red-500/30 text-red-400 font-['Space_Mono'] text-xs py-2 tracking-widest uppercase hover:bg-red-500/20 transition-colors">
                    ✕ Rechazar
                  </button>
                </div>` : ''}
              </div>
            `).join('')
        }
      `;
    } catch (error) {
      console.error('Error cargando citas:', error);
    }
  }

  // Aceptar o rechazar — sin contraseña, usa cookie
  (window as any).updateAppointment = async (id: string, status: string) => {
    try {
      const res = await fetch('/api/appointments', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status }),
      });
      if (!res.ok) throw new Error('Error actualizando cita');
      loadAppointments();
    } catch (error) {
      console.error('Error:', error);
    }
  };
</script>