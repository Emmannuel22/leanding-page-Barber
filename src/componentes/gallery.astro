---
const works = [
  { id: 1, title: 'Corte Clásico', tag: 'Clásico', img: '/images/fade7.jpeg'},
  { id: 2, title: 'Corte Clásico', tag: 'Clásico', img: '/images/fade2.jpeg' },
  { id: 3, title: 'Corte Fade', tag: 'Fade', img: '/images/fade3.jpeg' },
  { id: 4, title: 'Corte Fade', tag: 'Fade', img: '/images/fade4.jpeg' },
  { id: 5, title: 'Arreglo de Barba', tag: 'Barba', img: '/images/fadebarba.jpeg' },
  { id: 6, title: 'Arreglo de Barba', tag: 'Barba', img: '/images/fade1.jpeg' },
  { id: 7, title: 'Cejas', tag: 'Cejas', img: '/images/fade5.jpeg' },
  { id: 8, title: 'Corte + Barba', tag: 'Combo', img: '/images/fade6.jpeg' },
  { id: 9, title: 'Fade + Barba', tag: 'Combo', img: '/images/fade8.jpeg' },
];

const tags = ['Todos', 'Clásico', 'Fade', 'Barba', 'Cejas', 'Combo'];
---

<section id="galeria" class="py-24 bg-[#111]">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Header -->
    <div class="mb-16">
      <p class="font-['Space_Mono'] text-xs text-[#BFFF00] tracking-widest uppercase mb-3">— Nuestro trabajo</p>
      <h2 class="font-['Bebas_Neue'] text-6xl md:text-7xl text-white leading-none">
        GALERÍA
      </h2>
    </div>

    <!-- Filtros -->
    <div class="flex flex-wrap gap-2 mb-10">
      {tags.map((tag, i) => (
        <button
          data-filter={tag}
          class={`gallery-filter font-['Space_Mono'] text-xs tracking-widest uppercase px-4 py-2 border transition-all duration-300 ${
            i === 0
              ? 'bg-[#BFFF00] text-black border-[#BFFF00]'
              : 'text-gray-500 border-white/20 hover:border-[#BFFF00] hover:text-[#BFFF00]'
          }`}
        >
          {tag}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {works.map((work, i) => (
        <div
          data-tag={work.tag}
          class="gallery-item group relative aspect-square bg-[#1A1A1A] border border-white/10 overflow-hidden cursor-pointer"
        >
          <!-- Placeholder -->
          <img
            src={work.img}
            alt={work.title}
            class="w-full h-full object-cover"
          />

          <!-- Overlay hover -->
          <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col items-center justify-center gap-2">
            <span class="font-['Space_Mono'] text-xs text-[#BFFF00] tracking-widest uppercase">{work.tag}</span>
            <span class="font-['Bebas_Neue'] text-2xl text-white tracking-wide">{work.title}</span>
          </div>

          <!-- Número -->
          <div class="absolute top-3 left-3 font-['Space_Mono'] text-xs text-gray-600 group-hover:text-[#BFFF00] transition-colors duration-300">
            {String(i + 1).padStart(2, '0')}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.gallery-filter');
  const items = document.querySelectorAll('.gallery-item');

  // Activar botón "Todos" por default
  function setActiveBtn(activeBtn: Element) {
    filterBtns.forEach(b => {
      b.classList.remove('bg-[#BFFF00]', 'text-black', 'border-[#BFFF00]');
      b.classList.add('text-gray-500', 'border-white/20');
    });
    activeBtn.classList.remove('text-gray-500', 'border-white/20');
    activeBtn.classList.add('bg-[#BFFF00]', 'text-black', 'border-[#BFFF00]');
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      setActiveBtn(btn);

      items.forEach(item => {
        if (filter === 'Todos' || item.getAttribute('data-tag') === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>